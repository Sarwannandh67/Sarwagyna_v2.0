NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-03-13
SANITY_REVALIDATE_SECRET=your_revalidate_webhook_secret

# Required for /careers — job listings are not readable without a Viewer token
# Create at: https://www.sanity.io/manage → Project → API → Tokens → Add API token (Viewer)
SANITY_API_READ_TOKEN=your_sanity_viewer_token
